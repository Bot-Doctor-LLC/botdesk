# botdesk needs no environment configuration to build or run this snapshot.
# Everything below is optional. Copy to .env only if you need an override, and never commit .env.

# Debug builds on macOS: display name of the generated development app bundle (default: botdesk).
# MONOCODE_DEV_APP_NAME=botdesk

# Provider CLI homes, read from your normal shell environment when set.
# CODEX_HOME=
# CLAUDE_CONFIG_DIR=
# OPENCODE_CONFIG=
